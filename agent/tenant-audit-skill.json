{
  "skill_name": "microsoft_tenant_audit",
  "version": "3.0.0",
  "description": "Collect and summarize Microsoft 365 tenant posture into a local Auditex evidence bundle.",
  "default_runtime": "python",
  "entry": {
    "module": "auditex",
    "cli": "auditex"
  },
  "actions": [
    {
      "name": "tenant_audit.run_full_audit",
      "description": "Run the profile's full collector set as the reader app with its certificate.",
      "arguments": {
        "tenant_name": {
          "type": "string",
          "required": true
        },
        "tenant_id": {
          "type": "string",
          "required": true
        },
        "client_id": {
          "type": "string",
          "required": true
        },
        "certificate_path": {
          "type": "string",
          "required": true
        },
        "certificate_thumbprint": {
          "type": "string",
          "required": true
        },
        "out": {
          "type": "string",
          "required": false
        },
        "top": {
          "type": "integer",
          "required": false,
          "default": 0
        },
        "run_name": {
          "type": "string",
          "required": false
        },
        "auditor_profile": {
          "type": "string",
          "required": false,
          "default": "global-reader"
        }
      },
      "command_template": "auditex run --tenant-name {tenant_name} --tenant-id {tenant_id} --client-id {client_id} --certificate-path {certificate_path} --certificate-thumbprint {certificate_thumbprint} --out {out} --top {top} --auditor-profile {auditor_profile}"
    },
    {
      "name": "tenant_audit.run_security_audit",
      "description": "Run only identity/security collectors as the reader app with its certificate.",
      "arguments": {
        "tenant_name": {
          "type": "string",
          "required": true
        },
        "tenant_id": {
          "type": "string",
          "required": true
        },
        "client_id": {
          "type": "string",
          "required": true
        },
        "certificate_path": {
          "type": "string",
          "required": true
        },
        "certificate_thumbprint": {
          "type": "string",
          "required": true
        },
        "out": {
          "type": "string",
          "required": false
        },
        "top": {
          "type": "integer",
          "required": false,
          "default": 500
        },
        "run_name": {
          "type": "string",
          "required": false
        },
        "auditor_profile": {
          "type": "string",
          "required": false,
          "default": "global-reader"
        }
      },
      "command_template": "auditex run --tenant-name {tenant_name} --collectors identity,security --tenant-id {tenant_id} --client-id {client_id} --certificate-path {certificate_path} --certificate-thumbprint {certificate_thumbprint} --out {out} --top {top} --auditor-profile {auditor_profile}"
    },
    {
      "name": "tenant_audit.run_sample_audit",
      "description": "Run the offline sample pipeline for validation/testing.",
      "arguments": {
        "tenant_name": {
          "type": "string",
          "required": true
        },
        "sample": {
          "type": "string",
          "required": false,
          "default": "examples/sample_audit_bundle/sample_result.json"
        },
        "out": {
          "type": "string",
          "required": false
        }
      },
      "command_template": "PYTHONPATH=tenant-bootstrap python3 -m azure_tenant_audit --tenant-name {tenant_name} --offline --sample {sample} --out {out}"
    },
    {
      "name": "tenant_audit.run_full_bootstrap_and_audit",
      "description": "Run full Azure CLI bootstrap plus built-in audit collectors in one pass.",
      "arguments": {
        "tenant_name": {
          "type": "string",
          "required": true
        },
        "steps": {
          "type": "string",
          "required": false,
          "default": "licenses,teams,intune,security,devices,exchange,sample"
        },
        "collectors": {
          "type": "string",
          "required": false,
          "default": "identity,security,intune,teams,exchange"
        },
        "top": {
          "type": "integer",
          "required": false,
          "default": 500
        },
        "out": {
          "type": "string",
          "required": false
        },
        "run_name": {
          "type": "string",
          "required": false
        },
        "config_path": {
          "type": "string",
          "required": false,
          "default": "tenant-bootstrap/config.example.json"
        }
      },
      "command_template": "cd tenant-bootstrap && ./run-bootstrap-azurecli.sh --tenant-name {tenant_name} --config {config_path} --steps {steps} --audit-collectors {collectors} --audit-top {top} --run-name {run_name}"
    },
    {
      "name": "tenant_audit.run_enterprise_flow",
      "description": "Run one-command bootstrap + audit flow and print summaries.",
      "arguments": {
        "tenant_name": {
          "type": "string",
          "required": true
        },
        "steps": {
          "type": "string",
          "required": false,
          "default": "licenses,teams,intune,security,devices,exchange,sample"
        },
        "collectors": {
          "type": "string",
          "required": false,
          "default": "identity,security,intune,teams,exchange"
        },
        "top": {
          "type": "integer",
          "required": false,
          "default": 500
        },
        "run_name": {
          "type": "string",
          "required": false
        },
        "config_path": {
          "type": "string",
          "required": false,
          "default": "tenant-bootstrap/config.example.json"
        },
        "browser_command": {
          "type": "string",
          "required": false,
          "default": "firefox"
        },
        "auditor_profile": {
          "type": "string",
          "required": false,
          "default": "auto"
        }
      },
      "command_template": "cd tenant-bootstrap && ./run-enterprise-audit.sh --tenant-name {tenant_name} --config {config_path} --steps {steps} --collectors {collectors} --top {top} --run-name {run_name} --inspect --browser-command {browser_command} --auditor-profile {auditor_profile}"
    },
    {
      "name": "tenant_audit.summarize_run",
      "description": "Render a quick summary from a completed run manifest.",
      "arguments": {
        "run_dir": {
          "type": "string",
          "required": true
        }
      },
      "command_template": "ls {run_dir} && cat {run_dir}/summary.md"
    },
    {
      "name": "tenant_audit.run_bootstrap_dry",
      "description": "Run full Azure CLI bootstrap flow in dry-run mode (no tenant writes).",
      "arguments": {
        "tenant_name": {
          "type": "string",
          "required": true
        },
        "config_path": {
          "type": "string",
          "required": false,
          "default": "tenant-bootstrap/config.example.json"
        },
        "steps": {
          "type": "string",
          "required": false,
          "default": "licenses,teams,intune,security,devices,exchange,sample"
        }
      },
      "command_template": "cd tenant-bootstrap && ./run-bootstrap-azurecli.sh --tenant-name {tenant_name} --config {config_path} --steps {steps} --dry-run"
    },
    {
      "name": "tenant_audit.run_bootstrap_live",
      "description": "Run full Azure CLI bootstrap flow (writes tenant objects using Azure CLI token auth).",
      "arguments": {
        "tenant_name": {
          "type": "string",
          "required": true
        },
        "config_path": {
          "type": "string",
          "required": false,
          "default": "tenant-bootstrap/config.example.json"
        },
        "steps": {
          "type": "string",
          "required": false,
          "default": "licenses,teams,intune,security,devices,exchange,sample"
        }
      },
      "command_template": "cd tenant-bootstrap && ./run-bootstrap-azurecli.sh --tenant-name {tenant_name} --config {config_path} --steps {steps}"
    }
  ],
  "notes": [
    "Microsoft 365 audits use one way: the reader app with a certificate. The tenant administrator grants it from docs/guides/reader-app-permissions.md.",
    "Do not store credentials in source files. Keep the certificate's private key in an owner-only file; a key password comes only from --certificate-password-env or --certificate-password-file, never the command line.",
    "Use environment variables from configs/tenant-audit.example.env for local runs.",
    "A top of 0 means no row limit: every list is paged to its last row. A positive top is an explicit limit, and a list it cuts is recorded as a coverage gap."
  ]
}
