#!/usr/bin/env bash
set -euo pipefail
CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${CURRENT_DIR}/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: tenant-audit-full --tenant-id TENANT_ID --client-id APP_ID --certificate-path KEY_FILE
                         --certificate-thumbprint SHA1 [--certificate-password-env NAME | --certificate-password-file FILE]
                         [--tenant-name TENANT_NAME] [--collectors LIST] [--top N] [--run-name NAME] [--out PATH] [--dry-run]

Runs a Microsoft 365 audit as the reader app with its certificate, the only way Auditex signs in
(docs/guides/reader-app-permissions.md). No sign-in window opens.

Defaults:
  TENANT_NAME: tenant_id
  COLLECTORS: the global-reader profile
  TOP: none (every list is paged to its last row; --top N sets an explicit limit and records the cut as a coverage gap)
  OUTPUT: ./audit-output
  PYTHON: $AUDITEX_PYTHON (make audit-full passes the .venv interpreter), else python3 on PATH

Example:
  tenant-audit-full --tenant-id contoso.onmicrosoft.com --tenant-name CONTOSO --client-id <app-id> \
    --certificate-path auditex-reader.key.pem --certificate-thumbprint <thumbprint>
USAGE
}

TENANT_ID=""
TENANT_NAME=""
CLIENT_ID=""
CERTIFICATE_PATH=""
CERTIFICATE_THUMBPRINT=""
PASSWORD_ARGS=()
COLLECTORS=""
TOP=""
OUT_DIR="./audit-output"
RUN_NAME=""
DRY_RUN=0

REMOVED_OPTIONS=" --client-secret --access-token --use-azure-cli-token --interactive --include-exchange --reauth --m365-app-id "
VALUE_OPTIONS=" --tenant-id --tenant-name --client-id --certificate-path --certificate-thumbprint --certificate-password-env --certificate-password-file --collectors --top --out --run-name "

# Rejection messages never echo a raw argument: only an exact option name this script knows is named.
reject_argument() {
  echo "$1" >&2
  usage
  exit 1
}

ARGC=$#
while [[ $# -gt 0 ]]; do
  POSITION=$((ARGC - $# + 1))
  NAME="${1%%=*}"
  if [[ "${REMOVED_OPTIONS}" == *" ${NAME} "* ]]; then
    echo "${NAME} was removed: Microsoft 365 audits use only the reader app with a certificate (--client-id, --certificate-path, --certificate-thumbprint)." >&2
    exit 1
  fi
  if [[ "$1" == *=* ]]; then
    if [[ "${VALUE_OPTIONS}" == *" ${NAME} "* ]]; then
      reject_argument "${NAME}=VALUE is not accepted; pass ${NAME} VALUE (value not shown)."
    fi
    reject_argument "Unknown argument ${POSITION} (not shown)."
  fi
  if [[ "${VALUE_OPTIONS}" == *" $1 "* && $# -lt 2 ]]; then
    reject_argument "$1 needs a value."
  fi
  case "$1" in
    --tenant-id) TENANT_ID="$2"; shift 2 ;;
    --tenant-name) TENANT_NAME="$2"; shift 2 ;;
    --client-id) CLIENT_ID="$2"; shift 2 ;;
    --certificate-path) CERTIFICATE_PATH="$2"; shift 2 ;;
    --certificate-thumbprint) CERTIFICATE_THUMBPRINT="$2"; shift 2 ;;
    --certificate-password-env|--certificate-password-file) PASSWORD_ARGS=("$1" "$2"); shift 2 ;;
    --collectors) COLLECTORS="$2"; shift 2 ;;
    --top) TOP="$2"; shift 2 ;;
    --out) OUT_DIR="$2"; shift 2 ;;
    --run-name) RUN_NAME="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) reject_argument "Unknown argument ${POSITION} (not shown)." ;;
  esac
done

if [[ -z "${TENANT_ID}" || -z "${CLIENT_ID}" || -z "${CERTIFICATE_PATH}" || -z "${CERTIFICATE_THUMBPRINT}" ]]; then
  echo "The tenant ID, the reader app's client ID, its certificate key file and thumbprint are needed." >&2
  usage
  exit 2
fi
TENANT_NAME="${TENANT_NAME:-${TENANT_ID}}"

CMD=(
  env "PYTHONPATH=${ROOT}/src" "${AUDITEX_PYTHON:-python3}" -m azure_tenant_audit
  --tenant-name "${TENANT_NAME}" --tenant-id "${TENANT_ID}" --client-id "${CLIENT_ID}"
  --certificate-path "${CERTIFICATE_PATH}" --certificate-thumbprint "${CERTIFICATE_THUMBPRINT}"
  ${PASSWORD_ARGS[@]+"${PASSWORD_ARGS[@]}"}
  --out "${OUT_DIR}"
)
if [[ -n "${COLLECTORS}" ]]; then
  CMD+=(--collectors "${COLLECTORS}")
fi
if [[ -n "${TOP}" ]]; then
  CMD+=(--top "${TOP}")
fi
if [[ -n "${RUN_NAME}" ]]; then
  CMD+=(--run-name "${RUN_NAME}")
fi

if [[ "${DRY_RUN}" -eq 1 ]]; then
  echo "Dry run command:"
  redact_next=0
  for word in "${CMD[@]}"; do
    if [[ "${redact_next}" -eq 1 ]]; then
      printf '%q ' "***redacted***"
      redact_next=0
      continue
    fi
    printf '%q ' "${word}"
    case "${word}" in
      --certificate-path|--certificate-thumbprint|--certificate-password-env|--certificate-password-file) redact_next=1 ;;
    esac
  done
  echo
  exit 0
fi

set +e
"${CMD[@]}"
STATUS=$?
set -e
if [[ ${STATUS} -eq 0 ]]; then
  echo "Audit completed successfully."
else
  echo "Audit finished with issues (non-zero status ${STATUS}). Review diagnostics and permissions artifacts."
fi
exit ${STATUS}
