{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magrathean.uk/solutions/auditex/schemas/ce_plus_practice.schema.json",
  "title": "CE+ practice run: evidence observed and proof still needed per Cyber Essentials requirement (no assessment result)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "catalogue_version",
    "requirements_version",
    "test_specification_version",
    "disclaimer",
    "ranking_formula",
    "run",
    "evidence_quality",
    "summary",
    "requirements",
    "next_actions",
    "assessor_tests",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "ce-plus-practice-v1"
    },
    "kind": {
      "const": "ce_plus_practice_run"
    },
    "catalogue_version": {
      "type": "string",
      "minLength": 1
    },
    "requirements_version": {
      "type": "string",
      "minLength": 1
    },
    "test_specification_version": {
      "type": "string",
      "minLength": 1
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "ranking_formula": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "platform",
        "evidence_collected_utc",
        "as_of",
        "evidence_age_days"
      ],
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "enum": [
            "m365",
            "google_workspace",
            "unknown"
          ]
        },
        "evidence_collected_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "evidence_age_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "evidence_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flags",
        "coverage_data",
        "incomplete_collectors",
        "truncated_lists",
        "unmapped_requirement_ids",
        "dropped_requirement_id_count"
      ],
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "missing",
              "truncated",
              "stale",
              "conflicting",
              "requirements_version_mismatch"
            ]
          },
          "uniqueItems": true
        },
        "coverage_data": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "incomplete_collectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "truncated_lists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collector",
              "list",
              "reason"
            ],
            "properties": {
              "collector": {
                "type": "string",
                "minLength": 1
              },
              "list": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unmapped_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ce\\.[a-z]{2,16}\\.[a-z0-9]+(?:_[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "dropped_requirement_id_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements_total",
        "by_evidence_state",
        "next_action_count",
        "conflict_count"
      ],
      "properties": {
        "requirements_total": {
          "type": "integer",
          "minimum": 0
        },
        "by_evidence_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gap_observed",
            "evidence_unknown",
            "gap_accepted",
            "supporting_only",
            "evidence_observed_partial",
            "outside_tenant_evidence"
          ],
          "properties": {
            "gap_observed": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "gap_accepted": {
              "type": "integer",
              "minimum": 0
            },
            "supporting_only": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_observed_partial": {
              "type": "integer",
              "minimum": 0
            },
            "outside_tenant_evidence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "next_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "conflict_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "title",
          "theme",
          "requirement_status",
          "evidence_state",
          "evidence_flags",
          "unknown_reasons",
          "evidence_observed",
          "conflicts",
          "evidence_limits",
          "proof_still_needed",
          "assessor_test_ids"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "requirement_status": {
            "enum": [
              "automated",
              "partial",
              "manual",
              "ce_plus_assessor_test",
              "provider_responsibility"
            ]
          },
          "evidence_state": {
            "enum": [
              "gap_observed",
              "evidence_unknown",
              "gap_accepted",
              "supporting_only",
              "evidence_observed_partial",
              "outside_tenant_evidence"
            ]
          },
          "evidence_flags": {
            "type": "array",
            "items": {
              "enum": [
                "missing",
                "truncated",
                "stale",
                "conflicting"
              ]
            },
            "uniqueItems": true
          },
          "unknown_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_observed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rules_mapped",
              "rules_evaluated",
              "rules_with_gap",
              "open_finding_count",
              "finding_ids",
              "rule_states"
            ],
            "properties": {
              "rules_mapped": {
                "type": "integer",
                "minimum": 0
              },
              "rules_evaluated": {
                "type": "integer",
                "minimum": 0
              },
              "rules_with_gap": {
                "type": "integer",
                "minimum": 0
              },
              "open_finding_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "finding_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 20
              },
              "rule_states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule_id",
                    "state",
                    "confidence"
                  ],
                  "properties": {
                    "rule_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "gap_found",
                        "no_gap_found",
                        "not_evaluated",
                        "accepted_risk"
                      ]
                    },
                    "confidence": {
                      "enum": [
                        "full",
                        "partial",
                        "supporting"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "conflict_id",
                "note"
              ],
              "properties": {
                "conflict_id": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidence_limits": {
            "type": "string",
            "minLength": 1
          },
          "proof_still_needed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assessor_test_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minItems": 30,
      "maxItems": 30
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "action_id",
          "title",
          "kind",
          "effort",
          "effort_weight",
          "coverage",
          "coverage_gained",
          "rank_score",
          "proof_to_gather",
          "triggered_by"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "resolve_gap",
              "recollect",
              "gather_proof",
              "provider_assurance",
              "prepare_assessor_test"
            ]
          },
          "effort": {
            "enum": [
              "quick",
              "moderate",
              "extended"
            ]
          },
          "effort_weight": {
            "type": "integer",
            "minimum": 1
          },
          "coverage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "evidence_state",
                "weight"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_state": {
                  "enum": [
                    "gap_observed",
                    "evidence_unknown",
                    "gap_accepted",
                    "supporting_only",
                    "evidence_observed_partial",
                    "outside_tenant_evidence"
                  ]
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "coverage_gained": {
            "type": "integer",
            "minimum": 1
          },
          "rank_score": {
            "type": "integer",
            "minimum": 0
          },
          "proof_to_gather": {
            "type": "string",
            "minLength": 1
          },
          "triggered_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assessor_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "number",
          "title",
          "auditex_prepares",
          "assessor_witnesses",
          "requirement_ids",
          "linked_evidence",
          "prepare_action_ids",
          "witness_status"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "auditex_prepares": {
            "type": "string",
            "minLength": 1
          },
          "assessor_witnesses": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "linked_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "evidence_state",
                "evidence_flags"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_state": {
                  "enum": [
                    "gap_observed",
                    "evidence_unknown",
                    "gap_accepted",
                    "supporting_only",
                    "evidence_observed_partial",
                    "outside_tenant_evidence"
                  ]
                },
                "evidence_flags": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "missing",
                      "truncated",
                      "stale",
                      "conflicting"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "prepare_action_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "witness_status": {
            "const": "assessor_witness_required"
          }
        }
      },
      "minItems": 5,
      "maxItems": 5
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_title",
        "document_url",
        "licence"
      ],
      "properties": {
        "document_title": {
          "type": "string",
          "minLength": 1
        },
        "document_url": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pseudonym_notice": {
      "type": "string",
      "minLength": 1
    }
  }
}
