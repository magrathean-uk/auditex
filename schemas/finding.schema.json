{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditex Finding",
  "type": "object",
  "required": [
    "id",
    "severity",
    "title",
    "status",
    "category",
    "evidence_refs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "collector": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "impact": {
      "type": [
        "string",
        "null"
      ]
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_value": {},
    "returned_value": {},
    "risk_rating": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_path",
          "artifact_kind",
          "collector",
          "record_key"
        ],
        "properties": {
          "artifact_path": {
            "type": "string"
          },
          "artifact_kind": {
            "type": "string"
          },
          "collector": {
            "type": "string"
          },
          "record_key": {
            "type": "string"
          },
          "source_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "json_pointer": {
            "type": [
              "string",
              "null"
            ]
          },
          "jsonl_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "collected_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the cited record was collected: the record's own collected_at or observed_at, otherwise the run's created_utc."
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the cited artifact's bytes when the references were sealed."
          },
          "resolved": {
            "type": "boolean",
            "description": "Whether the artifact is inside the run directory and the record or JSON pointer exists in it."
          },
          "unresolved_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the reference did not resolve: artifact_missing, artifact_outside_run_dir, artifact_unreadable, artifact_not_addressable, record_not_found, json_pointer_not_found or jsonl_line_not_found."
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "framework_mappings": {
      "type": "object",
      "properties": {
        "cis_m365_v7": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cis_m365_v3": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "deprecated": true
        },
        "cisa_scuba": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ms_secure_score": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ms_zero_trust": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcsb": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cyber_essentials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "google_workspace_baseline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nist_800_53": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "iso_27001": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "soc2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nis2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dora": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mitre_attack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommendations": {
      "type": "object"
    },
    "waiver_applied": {
      "type": "boolean"
    },
    "waiver": {
      "type": [
        "object",
        "null"
      ]
    },
    "affected_objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
