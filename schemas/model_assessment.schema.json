{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magrathean.uk/solutions/auditex/schemas/model_assessment.schema.json",
  "title": "Optional model assessment (does not change findings)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2026-10-28"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_host": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "prompt_convention": {
      "type": "string",
      "const": "named-enums-v1"
    },
    "system_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "totals": {
      "type": "object",
      "properties": {
        "answered": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "rule_answered": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "answered",
        "unknown",
        "invalid",
        "skipped",
        "rule_answered"
      ],
      "additionalProperties": false
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "projection_not_implemented"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "endpoint_host",
    "model_name",
    "prompt_convention",
    "system_prompt_sha256",
    "totals",
    "policies",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "requirement_met",
            "policy_criticality"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "inferred",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^e[0-9]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "status",
        "value",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MS\\.[A-Z]+\\.\\d+\\.\\d+v\\d+$"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 2
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:required_evidence_section_not_collected|policy_scope_depends_on_licence|policy_not_applicable|model_response_invalid|model_endpoint_unavailable|required_evidence_section_not_collected:[A-Za-z_][A-Za-z0-9_.=,\\[\\]]*)$"
          },
          "uniqueItems": true
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "collect_missing_evidence_section",
              "review_policy_against_baseline_text"
            ]
          },
          "uniqueItems": true
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "unknown",
            "skipped"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "policy_not_in_catalogue",
            "model_response_invalid",
            "model_endpoint_unavailable",
            "rule_precheck"
          ]
        },
        "comparison": {
          "type": "object",
          "properties": {
            "baseline_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pass",
                "fail",
                "accepted_risk",
                "not_assessed",
                null
              ]
            },
            "model_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pass",
                "fail",
                null
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "agree",
                "disagree",
                "not_assessed"
              ]
            },
            "baseline_match": {
              "type": "string",
              "enum": [
                "exact",
                "version_mismatch",
                "none"
              ]
            }
          },
          "required": [
            "baseline_status",
            "model_status",
            "result",
            "baseline_match"
          ],
          "additionalProperties": false
        },
        "thinking_disabled": {
          "type": "boolean"
        },
        "thinking_stripped": {
          "type": "boolean"
        },
        "rule_precheck": {
          "$ref": "#/$defs/rule_precheck"
        },
        "model_shadow": {
          "$ref": "#/$defs/model_shadow"
        }
      },
      "required": [
        "policy_id",
        "claims",
        "limitations",
        "recommendations",
        "validation_status",
        "latency_ms",
        "attempts",
        "prompt_sha256",
        "response_sha256",
        "reason",
        "comparison",
        "thinking_disabled",
        "thinking_stripped"
      ],
      "additionalProperties": false
    },
    "rule_precheck": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "closed_gate",
            "absent_section"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "class",
        "rule_id",
        "section",
        "field",
        "value"
      ],
      "additionalProperties": false
    },
    "model_shadow": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MS\\.[A-Z]+\\.\\d+\\.\\d+v\\d+$"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 2
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:required_evidence_section_not_collected|policy_scope_depends_on_licence|policy_not_applicable|model_response_invalid|model_endpoint_unavailable|required_evidence_section_not_collected:[A-Za-z_][A-Za-z0-9_.=,\\[\\]]*)$"
          },
          "uniqueItems": true
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "collect_missing_evidence_section",
              "review_policy_against_baseline_text"
            ]
          },
          "uniqueItems": true
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "policy_not_in_catalogue",
            "model_response_invalid",
            "model_endpoint_unavailable"
          ]
        },
        "thinking_disabled": {
          "type": "boolean"
        },
        "thinking_stripped": {
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "claims",
        "limitations",
        "recommendations",
        "validation_status",
        "latency_ms",
        "attempts",
        "prompt_sha256",
        "response_sha256",
        "reason",
        "thinking_disabled",
        "thinking_stripped"
      ],
      "additionalProperties": false
    }
  }
}
