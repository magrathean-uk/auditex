{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magrathean.uk/solutions/auditex/schemas/model_assessment.schema.json",
  "title": "Optional model assessment (does not change findings)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2026-11-05"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_host": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "prompt_convention": {
      "type": "string",
      "const": "named-enums-v1"
    },
    "system_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "totals": {
      "type": "object",
      "properties": {
        "answered": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "rule_answered": {
          "type": "integer",
          "minimum": 0
        },
        "scope_narrowed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "answered",
        "unknown",
        "invalid",
        "skipped",
        "rule_answered"
      ],
      "additionalProperties": false
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      },
      "minItems": 1
    },
    "serving": {
      "type": "object",
      "description": "Request settings the client sent after negotiation, for comparison with the measured benchmark protocol. cache_prompt is disabled (cache_prompt: false sent, as benchmarked) or server_default (the server rejected the field, so llama-server may reuse a cached prompt prefix); response_format is json_object or not_sent (the server rejected it). Absent from assessments written before it was recorded.",
      "required": [
        "cache_prompt",
        "response_format"
      ],
      "properties": {
        "cache_prompt": {
          "type": "string",
          "enum": [
            "disabled",
            "server_default"
          ]
        },
        "response_format": {
          "type": "string",
          "enum": [
            "json_object",
            "not_sent"
          ]
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "projection_not_implemented"
        ]
      },
      "uniqueItems": true
    },
    "projection": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "2026-10-29"
        },
        "sections": {
          "type": "object",
          "properties": {
            "SPO_tenant": {
              "$ref": "#/$defs/projection_section"
            },
            "accepted_domains": {
              "$ref": "#/$defs/projection_section"
            },
            "admin_audit_log_config": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_malware_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_malware_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_phish_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_phish_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "app_management_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "app_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "atp_policy_for_o365": {
              "$ref": "#/$defs/projection_section"
            },
            "atp_policy_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "authentication_method": {
              "$ref": "#/$defs/projection_section"
            },
            "authorization_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "broadcast_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "built_in_protection_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "client_configuration": {
              "$ref": "#/$defs/projection_section"
            },
            "conditional_access_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "conn_filter": {
              "$ref": "#/$defs/projection_section"
            },
            "default_app_management_policy": {
              "$ref": "#/$defs/projection_section"
            },
            "defender_dlp_license": {
              "$ref": "#/$defs/projection_section"
            },
            "defender_license": {
              "$ref": "#/$defs/projection_section"
            },
            "directory_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "dkim_config": {
              "$ref": "#/$defs/projection_section"
            },
            "dkim_records": {
              "$ref": "#/$defs/projection_section"
            },
            "dlp_compliance_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "dlp_compliance_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "dlp_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "dmarc_records": {
              "$ref": "#/$defs/projection_section"
            },
            "domain_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "environment_creation": {
              "$ref": "#/$defs/projection_section"
            },
            "environment_list": {
              "$ref": "#/$defs/projection_section"
            },
            "federation_configuration": {
              "$ref": "#/$defs/projection_section"
            },
            "hosted_content_filter_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "hosted_content_filter_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "meeting_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "org_config": {
              "$ref": "#/$defs/projection_section"
            },
            "powerbi_access_denied_reason": {
              "$ref": "#/$defs/projection_section"
            },
            "powerbi_license_found": {
              "$ref": "#/$defs/projection_section"
            },
            "powerbi_tenant_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "privileged_roles": {
              "$ref": "#/$defs/projection_section"
            },
            "privileged_users": {
              "$ref": "#/$defs/projection_section"
            },
            "protection_alerts": {
              "$ref": "#/$defs/projection_section"
            },
            "protection_policy_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "remote_domains": {
              "$ref": "#/$defs/projection_section"
            },
            "risky_delegated_permission_classifications": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_attachment_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_attachment_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_links_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_links_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "scuba_config": {
              "$ref": "#/$defs/projection_section"
            },
            "service_plans": {
              "$ref": "#/$defs/projection_section"
            },
            "sharing_policy": {
              "$ref": "#/$defs/projection_section"
            },
            "spf_records": {
              "$ref": "#/$defs/projection_section"
            },
            "tenant_app_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "tenant_id": {
              "$ref": "#/$defs/projection_section"
            },
            "tenant_isolation": {
              "$ref": "#/$defs/projection_section"
            },
            "transport_config": {
              "$ref": "#/$defs/projection_section"
            },
            "transport_rule": {
              "$ref": "#/$defs/projection_section"
            }
          },
          "required": [
            "SPO_tenant",
            "accepted_domains",
            "admin_audit_log_config",
            "anti_malware_policies",
            "anti_malware_rules",
            "anti_phish_policies",
            "anti_phish_rules",
            "app_management_policies",
            "app_policies",
            "atp_policy_for_o365",
            "atp_policy_rules",
            "authentication_method",
            "authorization_policies",
            "broadcast_policies",
            "built_in_protection_rules",
            "client_configuration",
            "conditional_access_policies",
            "conn_filter",
            "default_app_management_policy",
            "defender_dlp_license",
            "defender_license",
            "directory_settings",
            "dkim_config",
            "dkim_records",
            "dlp_compliance_policies",
            "dlp_compliance_rules",
            "dlp_policies",
            "dmarc_records",
            "domain_settings",
            "environment_creation",
            "environment_list",
            "federation_configuration",
            "hosted_content_filter_policies",
            "hosted_content_filter_rules",
            "meeting_policies",
            "org_config",
            "powerbi_access_denied_reason",
            "powerbi_license_found",
            "powerbi_tenant_settings",
            "privileged_roles",
            "privileged_users",
            "protection_alerts",
            "protection_policy_rules",
            "remote_domains",
            "risky_delegated_permission_classifications",
            "safe_attachment_policies",
            "safe_attachment_rules",
            "safe_links_policies",
            "safe_links_rules",
            "scuba_config",
            "service_plans",
            "sharing_policy",
            "spf_records",
            "tenant_app_settings",
            "tenant_id",
            "tenant_isolation",
            "transport_config",
            "transport_rule"
          ],
          "additionalProperties": false
        },
        "redaction": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "strategy": {
              "type": "string",
              "const": "run-salted-sha256-v1"
            },
            "user_display_names": {
              "type": "integer",
              "minimum": 0
            },
            "email_addresses": {
              "type": "integer",
              "minimum": 0
            },
            "immutable_ids": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "enabled",
            "strategy",
            "user_display_names",
            "email_addresses",
            "immutable_ids"
          ],
          "additionalProperties": false
        },
        "bounds": {
          "type": "object",
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 1
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1
            },
            "scan_max_rows": {
              "type": "integer",
              "minimum": 1
            },
            "scan_max_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "scan_max_chunks": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_items",
            "max_chars"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "sections",
        "redaction",
        "bounds"
      ],
      "additionalProperties": false
    },
    "scope_post_check": {
      "$ref": "#/$defs/scope_post_check"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "endpoint_host",
    "model_name",
    "prompt_convention",
    "system_prompt_sha256",
    "totals",
    "policies",
    "limitations",
    "projection"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "requirement_met",
            "policy_criticality"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "inferred",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^e[0-9]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "status",
        "value",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MS\\.[A-Z]+\\.\\d+\\.\\d+v\\d+$"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 2
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:optional_collection_not_enabled|evidence_unusable|evidence_unusable:[A-Za-z_][A-Za-z0-9_]*:(?:blocked|absent|unusable|undecidable)|required_evidence_section_not_collected|policy_scope_depends_on_licence|policy_not_applicable|model_response_invalid|model_endpoint_unavailable|model_transport_failed|scope_narrowed|required_evidence_section_not_collected:[A-Za-z_][A-Za-z0-9_.=,\\[\\]]*)$"
          },
          "uniqueItems": true
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "collect_missing_evidence_section",
              "review_policy_against_baseline_text",
              "report_product_fault",
              "check_licence_or_permissions",
              "recollect_unusable_evidence"
            ]
          },
          "uniqueItems": true
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "unknown",
            "skipped"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "policy_not_in_catalogue",
            "model_response_invalid",
            "model_endpoint_unavailable",
            "model_transport_failed",
            "rule_precheck",
            "rule_not_implemented"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "description": "Model rows only: the finish_reason of the final chat-completions reply (stop, length, ...); null when no reply arrived or the server sent none or a non-token value. Absent from rule and skipped rows and from assessments written before it was recorded."
        },
        "comparison": {
          "type": "object",
          "properties": {
            "baseline_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pass",
                "fail",
                "accepted_risk",
                "not_assessed",
                null
              ]
            },
            "model_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pass",
                "fail",
                null
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "agree",
                "disagree",
                "not_assessed"
              ]
            },
            "baseline_match": {
              "type": "string",
              "enum": [
                "exact",
                "version_mismatch",
                "none"
              ]
            }
          },
          "required": [
            "baseline_status",
            "model_status",
            "result",
            "baseline_match"
          ],
          "additionalProperties": false
        },
        "thinking_disabled": {
          "type": "boolean"
        },
        "thinking_stripped": {
          "type": "boolean"
        },
        "rule_precheck": {
          "$ref": "#/$defs/rule_precheck"
        },
        "model_shadow": {
          "$ref": "#/$defs/model_shadow"
        },
        "reason_text": {
          "const": "Not assessed: Auditex has no rule for this policy yet."
        },
        "post_check": {
          "$ref": "#/$defs/post_check"
        }
      },
      "required": [
        "policy_id",
        "claims",
        "limitations",
        "recommendations",
        "validation_status",
        "latency_ms",
        "attempts",
        "prompt_sha256",
        "response_sha256",
        "reason",
        "comparison",
        "thinking_disabled",
        "thinking_stripped"
      ],
      "additionalProperties": false
    },
    "rule_precheck": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "closed_gate",
            "absent_section",
            "absent_field",
            "empty_required_list",
            "value_rule"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cell": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        },
        "reason_text": {
          "type": "string",
          "maxLength": 400
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "class",
        "rule_id",
        "section",
        "field",
        "value"
      ],
      "additionalProperties": false
    },
    "model_shadow": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MS\\.[A-Z]+\\.\\d+\\.\\d+v\\d+$"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 2
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:required_evidence_section_not_collected|policy_scope_depends_on_licence|policy_not_applicable|model_response_invalid|model_endpoint_unavailable|model_transport_failed|required_evidence_section_not_collected:[A-Za-z_][A-Za-z0-9_.=,\\[\\]]*)$"
          },
          "uniqueItems": true
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "collect_missing_evidence_section",
              "review_policy_against_baseline_text"
            ]
          },
          "uniqueItems": true
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "policy_not_in_catalogue",
            "model_response_invalid",
            "model_endpoint_unavailable",
            "model_transport_failed"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "description": "Model rows only: the finish_reason of the final chat-completions reply (stop, length, ...); null when no reply arrived or the server sent none or a non-token value. Absent from rule and skipped rows and from assessments written before it was recorded."
        },
        "thinking_disabled": {
          "type": "boolean"
        },
        "thinking_stripped": {
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "claims",
        "limitations",
        "recommendations",
        "validation_status",
        "latency_ms",
        "attempts",
        "prompt_sha256",
        "response_sha256",
        "reason",
        "thinking_disabled",
        "thinking_stripped"
      ],
      "additionalProperties": false
    },
    "post_check": {
      "type": "object",
      "description": "Deterministic scope post-check of a met verdict (kind scope_narrowed). The verdict is unchanged: ScubaGear's Rego ignores these conditions. policies are the distinct display names of the enabled Conditional Access policies that could have decided the item (they carry every check the Rego makes of a deciding policy) and carry a condition, when no compliant unscoped policy could have decided it as well (at most the projection item budget, sorted); count is how many such policies there are; conditions are the Graph condition paths found.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "scope_narrowed"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "conditions.clientAppTypes",
              "conditions.clientApplications",
              "conditions.devices",
              "conditions.locations",
              "conditions.platforms",
              "grantControls.operator"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "policies",
        "conditions",
        "count"
      ],
      "additionalProperties": false
    },
    "scope_post_check": {
      "type": "object",
      "description": "Envelope record of the scope post-check, whatever the verdicts: the enabled Conditional Access policies that carry a location, platform, device, client-application or client-application-type condition that some tabled item they could have decided ignores. source is the projected section when it was projected, else the bundle's raw payload; reason says why it was not evaluated.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "evaluated",
            "not_evaluated"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "projection",
            "raw",
            null
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "missing_artifact",
            "incomplete_shape",
            "oversize",
            "not_applicable_to_platform"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope_policy"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "source",
        "reason",
        "count",
        "policies"
      ],
      "additionalProperties": false
    },
    "scope_policy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "conditions.clientAppTypes",
              "conditions.clientApplications",
              "conditions.devices",
              "conditions.locations",
              "conditions.platforms"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "conditions"
      ],
      "additionalProperties": false
    },
    "projection_section": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "projected",
            "not_collected"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "missing_artifact",
            "incomplete_shape",
            "oversize",
            "powershell_only",
            "not_applicable_to_platform",
            "dns_posture_not_run",
            "dns_records_not_saved",
            "collector_error",
            "optional_collection_not_enabled"
          ]
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:raw|normalized|chunks)/[^\\\\]+$|^(?:run-manifest|coverage)\\.json$"
          },
          "uniqueItems": true
        },
        "unsupported_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.]*$"
          },
          "uniqueItems": true
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/projection_detail"
            },
            {
              "$ref": "#/$defs/projection_collector_error"
            }
          ]
        },
        "scan": {
          "type": "object",
          "description": "Rows examined, bytes read and chunk files opened to scan the section's source operations; present when anything was scanned.",
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "chunks": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "rows",
            "bytes",
            "chunks"
          ],
          "additionalProperties": false
        },
        "ignored_failures": {
          "type": "array",
          "description": "Operations of a read collector that reported a failure the section does not read; recorded, never withholding.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "ignored_fields": {
          "type": "array",
          "description": "Field paths the source carried that the training shape does not know: names only, never values (a key that is not an identifier is masked as unrecognisedField), sorted. They are never projected and never withhold the section.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "uniqueItems": true
        },
        "dropped_conditions": {
          "type": "array",
          "description": "Conditional Access only: conditions and controls dropped from a policy that is not enabled, as <policy id>:<field path> (the id is the policy's GUID, else policy<position>), sorted. The pinned ScubaGear rules read only enabled policies, so such a policy stays in the projection with its state and does not withhold the section.",
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}|policy[0-9]+):[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
          },
          "uniqueItems": true
        },
        "null_lists_read_as_empty": {
          "type": "array",
          "description": "Conditional Access only: list fields (ProviderExport spelling) that Graph returned as null and the projection read as an empty list, sorted. The pinned Rego reads a null list as empty.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$"
          },
          "uniqueItems": true
        },
        "synthesis": {
          "type": "object",
          "description": "Present on scuba_config only: the section is ScubaGear's operator configuration, synthesised rather than read from the tenant. policies gives each reading policy's outcome; a policy that is not projected sees the not-collected marker.",
          "properties": {
            "source": {
              "type": "string",
              "const": "synthesised:default-config"
            },
            "basis": {
              "type": "string",
              "const": "scubagear_default_config"
            },
            "m365_environment": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "commercial",
                    "gcc",
                    "gcchigh",
                    "dod",
                    null
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "openid_discovery",
                    "licence_sku",
                    "assumed_default",
                    "ambiguous",
                    "unreadable"
                  ]
                }
              },
              "required": [
                "value",
                "basis"
              ],
              "additionalProperties": false
            },
            "break_glass": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "none",
                    "operator",
                    "unrecorded"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "resolved",
                    "unresolved",
                    "identity_unreadable"
                  ]
                },
                "entries": {
                  "type": "integer",
                  "minimum": 0
                },
                "unresolved": {
                  "type": "integer",
                  "minimum": 0
                },
                "unverified": {
                  "type": "integer",
                  "minimum": 0
                },
                "users": {
                  "type": "integer",
                  "minimum": 0
                },
                "groups": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "policies": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "projected",
                  "operator_input_required",
                  "break_glass_unresolved",
                  "environment_ambiguous",
                  "unseen_shape",
                  "oversize"
                ]
              },
              "description": "Keyed by every policy whose catalogue sections include scuba_config; checked by validate_assessment."
            }
          },
          "required": [
            "source",
            "basis",
            "m365_environment",
            "break_glass",
            "policies"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "reason",
        "source"
      ],
      "additionalProperties": false
    },
    "projection_detail": {
      "type": "object",
      "description": "First failed projection check; field paths omit array indices and mask unknown keys. $ denotes a whole-section shape failure. For kind scan_bound (reason oversize) field names the scan bound that ran out. Values are diagnostic only, never evidence.",
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(?:\\$|[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*)$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "missing_field",
            "unexpected_field",
            "unseen_enum_value",
            "unseen_shape",
            "invalid_type",
            "scan_bound"
          ]
        },
        "value": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^(?:everyone|none|adminsAndGuestInviters|adminsGuestInvitersAndAllMembers)$"
        }
      },
      "required": [
        "field",
        "kind"
      ],
      "additionalProperties": false
    },
    "projection_collector_error": {
      "type": "object",
      "description": "Detail of reason collector_error: the collector recorded the read as failed. Only its error class (never its message) and, when known, the <collector>.<operation> that failed. The validator also checks the class against the collectors' vocabulary (COLLECTOR_ERROR_CLASSES, plus graph_http_<status>); any other class is reported as unclassified.",
      "properties": {
        "error_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "error_class"
      ],
      "additionalProperties": false
    }
  }
}
