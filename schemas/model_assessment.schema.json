{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magrathean.uk/solutions/auditex/schemas/model_assessment.schema.json",
  "title": "Optional model assessment (does not change findings)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2026-10-29"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_host": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "prompt_convention": {
      "type": "string",
      "const": "named-enums-v1"
    },
    "system_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "totals": {
      "type": "object",
      "properties": {
        "answered": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "rule_answered": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "answered",
        "unknown",
        "invalid",
        "skipped",
        "rule_answered"
      ],
      "additionalProperties": false
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "projection_not_implemented"
        ]
      },
      "uniqueItems": true
    },
    "projection": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "2026-10-29"
        },
        "sections": {
          "type": "object",
          "properties": {
            "SPO_tenant": {
              "$ref": "#/$defs/projection_section"
            },
            "accepted_domains": {
              "$ref": "#/$defs/projection_section"
            },
            "admin_audit_log_config": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_malware_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_malware_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_phish_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "anti_phish_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "app_management_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "app_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "atp_policy_for_o365": {
              "$ref": "#/$defs/projection_section"
            },
            "atp_policy_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "authentication_method": {
              "$ref": "#/$defs/projection_section"
            },
            "authorization_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "broadcast_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "built_in_protection_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "client_configuration": {
              "$ref": "#/$defs/projection_section"
            },
            "conditional_access_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "conn_filter": {
              "$ref": "#/$defs/projection_section"
            },
            "default_app_management_policy": {
              "$ref": "#/$defs/projection_section"
            },
            "defender_dlp_license": {
              "$ref": "#/$defs/projection_section"
            },
            "defender_license": {
              "$ref": "#/$defs/projection_section"
            },
            "directory_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "dkim_config": {
              "$ref": "#/$defs/projection_section"
            },
            "dkim_records": {
              "$ref": "#/$defs/projection_section"
            },
            "dlp_compliance_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "dlp_compliance_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "dlp_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "dmarc_records": {
              "$ref": "#/$defs/projection_section"
            },
            "domain_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "environment_creation": {
              "$ref": "#/$defs/projection_section"
            },
            "environment_list": {
              "$ref": "#/$defs/projection_section"
            },
            "federation_configuration": {
              "$ref": "#/$defs/projection_section"
            },
            "hosted_content_filter_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "hosted_content_filter_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "meeting_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "org_config": {
              "$ref": "#/$defs/projection_section"
            },
            "powerbi_access_denied_reason": {
              "$ref": "#/$defs/projection_section"
            },
            "powerbi_license_found": {
              "$ref": "#/$defs/projection_section"
            },
            "powerbi_tenant_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "privileged_roles": {
              "$ref": "#/$defs/projection_section"
            },
            "privileged_users": {
              "$ref": "#/$defs/projection_section"
            },
            "protection_alerts": {
              "$ref": "#/$defs/projection_section"
            },
            "protection_policy_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "remote_domains": {
              "$ref": "#/$defs/projection_section"
            },
            "risky_delegated_permission_classifications": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_attachment_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_attachment_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_links_policies": {
              "$ref": "#/$defs/projection_section"
            },
            "safe_links_rules": {
              "$ref": "#/$defs/projection_section"
            },
            "scuba_config": {
              "$ref": "#/$defs/projection_section"
            },
            "service_plans": {
              "$ref": "#/$defs/projection_section"
            },
            "sharing_policy": {
              "$ref": "#/$defs/projection_section"
            },
            "spf_records": {
              "$ref": "#/$defs/projection_section"
            },
            "tenant_app_settings": {
              "$ref": "#/$defs/projection_section"
            },
            "tenant_id": {
              "$ref": "#/$defs/projection_section"
            },
            "tenant_isolation": {
              "$ref": "#/$defs/projection_section"
            },
            "transport_config": {
              "$ref": "#/$defs/projection_section"
            },
            "transport_rule": {
              "$ref": "#/$defs/projection_section"
            }
          },
          "required": [
            "SPO_tenant",
            "accepted_domains",
            "admin_audit_log_config",
            "anti_malware_policies",
            "anti_malware_rules",
            "anti_phish_policies",
            "anti_phish_rules",
            "app_management_policies",
            "app_policies",
            "atp_policy_for_o365",
            "atp_policy_rules",
            "authentication_method",
            "authorization_policies",
            "broadcast_policies",
            "built_in_protection_rules",
            "client_configuration",
            "conditional_access_policies",
            "conn_filter",
            "default_app_management_policy",
            "defender_dlp_license",
            "defender_license",
            "directory_settings",
            "dkim_config",
            "dkim_records",
            "dlp_compliance_policies",
            "dlp_compliance_rules",
            "dlp_policies",
            "dmarc_records",
            "domain_settings",
            "environment_creation",
            "environment_list",
            "federation_configuration",
            "hosted_content_filter_policies",
            "hosted_content_filter_rules",
            "meeting_policies",
            "org_config",
            "powerbi_access_denied_reason",
            "powerbi_license_found",
            "powerbi_tenant_settings",
            "privileged_roles",
            "privileged_users",
            "protection_alerts",
            "protection_policy_rules",
            "remote_domains",
            "risky_delegated_permission_classifications",
            "safe_attachment_policies",
            "safe_attachment_rules",
            "safe_links_policies",
            "safe_links_rules",
            "scuba_config",
            "service_plans",
            "sharing_policy",
            "spf_records",
            "tenant_app_settings",
            "tenant_id",
            "tenant_isolation",
            "transport_config",
            "transport_rule"
          ],
          "additionalProperties": false
        },
        "redaction": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "strategy": {
              "type": "string",
              "const": "run-salted-sha256-v1"
            },
            "user_display_names": {
              "type": "integer",
              "minimum": 0
            },
            "email_addresses": {
              "type": "integer",
              "minimum": 0
            },
            "immutable_ids": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "enabled",
            "strategy",
            "user_display_names",
            "email_addresses",
            "immutable_ids"
          ],
          "additionalProperties": false
        },
        "bounds": {
          "type": "object",
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 1
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_items",
            "max_chars"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "sections",
        "redaction",
        "bounds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "endpoint_host",
    "model_name",
    "prompt_convention",
    "system_prompt_sha256",
    "totals",
    "policies",
    "limitations",
    "projection"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "requirement_met",
            "policy_criticality"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "inferred",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^e[0-9]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "status",
        "value",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MS\\.[A-Z]+\\.\\d+\\.\\d+v\\d+$"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 2
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:required_evidence_section_not_collected|policy_scope_depends_on_licence|policy_not_applicable|model_response_invalid|model_endpoint_unavailable|required_evidence_section_not_collected:[A-Za-z_][A-Za-z0-9_.=,\\[\\]]*)$"
          },
          "uniqueItems": true
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "collect_missing_evidence_section",
              "review_policy_against_baseline_text"
            ]
          },
          "uniqueItems": true
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "unknown",
            "skipped"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "policy_not_in_catalogue",
            "model_response_invalid",
            "model_endpoint_unavailable",
            "rule_precheck"
          ]
        },
        "comparison": {
          "type": "object",
          "properties": {
            "baseline_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pass",
                "fail",
                "accepted_risk",
                "not_assessed",
                null
              ]
            },
            "model_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pass",
                "fail",
                null
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "agree",
                "disagree",
                "not_assessed"
              ]
            },
            "baseline_match": {
              "type": "string",
              "enum": [
                "exact",
                "version_mismatch",
                "none"
              ]
            }
          },
          "required": [
            "baseline_status",
            "model_status",
            "result",
            "baseline_match"
          ],
          "additionalProperties": false
        },
        "thinking_disabled": {
          "type": "boolean"
        },
        "thinking_stripped": {
          "type": "boolean"
        },
        "rule_precheck": {
          "$ref": "#/$defs/rule_precheck"
        },
        "model_shadow": {
          "$ref": "#/$defs/model_shadow"
        }
      },
      "required": [
        "policy_id",
        "claims",
        "limitations",
        "recommendations",
        "validation_status",
        "latency_ms",
        "attempts",
        "prompt_sha256",
        "response_sha256",
        "reason",
        "comparison",
        "thinking_disabled",
        "thinking_stripped"
      ],
      "additionalProperties": false
    },
    "rule_precheck": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "closed_gate",
            "absent_section"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "class",
        "rule_id",
        "section",
        "field",
        "value"
      ],
      "additionalProperties": false
    },
    "model_shadow": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MS\\.[A-Z]+\\.\\d+\\.\\d+v\\d+$"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 2
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:required_evidence_section_not_collected|policy_scope_depends_on_licence|policy_not_applicable|model_response_invalid|model_endpoint_unavailable|required_evidence_section_not_collected:[A-Za-z_][A-Za-z0-9_.=,\\[\\]]*)$"
          },
          "uniqueItems": true
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "collect_missing_evidence_section",
              "review_policy_against_baseline_text"
            ]
          },
          "uniqueItems": true
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ]
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "policy_not_in_catalogue",
            "model_response_invalid",
            "model_endpoint_unavailable"
          ]
        },
        "thinking_disabled": {
          "type": "boolean"
        },
        "thinking_stripped": {
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "claims",
        "limitations",
        "recommendations",
        "validation_status",
        "latency_ms",
        "attempts",
        "prompt_sha256",
        "response_sha256",
        "reason",
        "thinking_disabled",
        "thinking_stripped"
      ],
      "additionalProperties": false
    },
    "projection_section": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "projected",
            "not_collected"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "missing_artifact",
            "incomplete_shape",
            "oversize",
            "powershell_only",
            "not_applicable_to_platform"
          ]
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:raw|normalized|chunks)/[^\\\\]+$|^(?:run-manifest|coverage)\\.json$"
          },
          "uniqueItems": true
        },
        "unsupported_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "reason",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
