{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditex Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_name",
    "run_id",
    "overall_status",
    "mode",
    "auditor_profile",
    "selected_collectors",
    "artifacts",
    "evidence_db_path",
    "ai_context_path",
    "validation_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string"
    },
    "tenant_id": {
      "type": ["string", "null"]
    },
    "tenant_id_requested": {
      "type": ["string", "null"]
    },
    "tenant_identity": {
      "type": "object"
    },
    "platform": {
      "type": "string"
    },
    "workspace_domain": {
      "type": ["string", "null"]
    },
    "customer_id": {
      "type": ["string", "null"]
    },
    "run_id": {
      "type": "string"
    },
    "created_utc": {
      "type": "string"
    },
    "overall_status": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "auditor_profile": {
      "type": "string"
    },
    "plane": {
      "type": "string"
    },
    "selected_collectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker_count": {
      "type": "integer"
    },
    "findings_count": {
      "type": "integer"
    },
    "report_pack_path": {
      "type": "string"
    },
    "action_plan_path": {
      "type": "string"
    },
    "evidence_db_path": {
      "type": "string"
    },
    "ai_context_path": {
      "type": "string"
    },
    "validation_path": {
      "type": "string"
    },
    "live_readiness_path": {
      "type": "string"
    },
    "privacy": {
      "type": "object"
    },
    "data_handling_path": {
      "type": "string"
    },
    "audit_plan_path": {
      "type": "string"
    },
    "api_inventory_path": {
      "type": "string"
    },
    "autopilot_quality": {
      "type": "object"
    },
    "data_handling_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assurance": {
      "type": "object"
    },
    "surface_coverage": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provider_scorecard": {
      "type": "object"
    },
    "time_window": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_status": {
      "type": "string"
    },
    "contract_issue_count": {
      "type": "integer"
    },
    "schema_contract_version": {
      "type": "string"
    },
    "rule_parameters": {
      "type": "object",
      "description": "The windows and lists the run's rules were judged with: stale_sync_days, stale_guest_days, stale_account_days (Microsoft 365), stale_user_days, stale_device_days (Google Workspace) and break_glass_accounts (the emergency-access list the Conditional Access verdicts exempted). Run comparison and the gates read them back.",
      "properties": {
        "break_glass_accounts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "replay_source": {
      "type": "object",
      "description": "Offline replays only: the sample the evidence was replayed from. No tenant was contacted.",
      "properties": {
        "file": { "type": "string", "description": "The sample's file name, never its directory." },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
