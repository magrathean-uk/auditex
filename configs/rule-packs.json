        "diagnostic",
        "service"
      ],
      "path": "findings/diagnostics",
      "product_family": "core",
      "license_tiers": [
        "all"
      ],
      "audit_levels": [
        "baseline",
        "deep"
      ],
      "enabled": true
    },
    {
      "name": "sharepoint.broad_link",
