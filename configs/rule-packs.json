{
  "rules": [
    {
      "name": "collector.issue.permission",
      "title": "Collector missing read access",
      "description": "The audit identity cannot read a requested Microsoft 365 surface.",
      "tags": [
        "diagnostic",
        "permission"
      ],
      "path": "findings/diagnostics",
      "product_family": "core",
      "license_tiers": [
        "all"
      ],
