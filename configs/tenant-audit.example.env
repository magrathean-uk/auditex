# Microsoft 365 audits use one way: the reader app with a certificate (DEC-107).
# The grant is in docs/guides/reader-app-permissions.md. The certificate key file and thumbprint
# are passed as --certificate-path and --certificate-thumbprint; a key password only through
# --certificate-password-env (the name of a variable) or --certificate-password-file.
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<reader-app-application-id>
AZURE_AUTHORITY=https://login.microsoftonline.com/
AZURE_GRAPH_SCOPE=https://graph.microsoft.com/.default

AUDIT_OUTPUT_DIR=./audit-output
AUDIT_COLLECTORS=identity,security,intune,teams
AUDIT_SAMPLE_FILE=examples/sample_audit_bundle/sample_result.json
