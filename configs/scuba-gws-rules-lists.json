{
  "kinds": {
    "gws_list_settings": {
      "cells": {
        "no_unit_violates": {
          "reason_code": "no_unit_violates",
          "reason_texts": [
            "Requirement met: no org unit or group holds a value this policy forbids."
          ],
          "verdict": "met"
        },
        "policy_read_incomplete": {
          "evidence_kind": "absent",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:absent"
          ],
          "reason_code": "data_unavailable_policy_read_incomplete",
          "reason_texts": [
            "Data unavailable: the Google Workspace policy or org unit read was incomplete, so an unset value cannot be told from an unread one."
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ],
          "verdict": "not_assessed"
        },
        "section_not_collected": {
          "evidence_kind": null,
          "limitations": [
            "required_evidence_section_not_collected",
            "required_evidence_section_not_collected:<section>"
          ],
          "reason_code": "required_evidence_section_not_collected",
          "recommendations": [
            "collect_missing_evidence_section"
          ],
          "verdict": "not_assessed"
        },
        "section_shape_unusable": {
          "evidence_kind": "unusable",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:unusable"
          ],
          "reason_code": "data_unusable_section_shape",
          "reason_texts": [
            "Data unusable: the Google Workspace policy or org unit evidence has the wrong shape for this check."
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ],
          "verdict": "not_assessed"
        },
        "service_off_everywhere": {
          "reason_code": "service_off_everywhere",
          "reason_texts": [
            "Not applicable: the service this policy covers is read as off in every org unit and group."
          ],
          "verdict": "not_applicable"
        },
        "service_status_absent": {
          "evidence_kind": "absent",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:absent"
          ],
          "reason_code": "data_unavailable_service_status_absent",
          "reason_texts": [
            "Data unavailable: the service on or off status could not be read for a unit this policy covers."
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ],
          "verdict": "not_assessed"
        },
        "setting_absent": {
          "evidence_kind": "absent",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:absent"
          ],
          "reason_code": "data_unavailable_setting_absent",
          "reason_texts": [
            "Data unavailable: the setting this policy reads was not returned and no default is pinned, so compliance is unknown."
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ],
          "verdict": "not_assessed"
        },
        "setting_value_unusable": {
          "evidence_kind": "unusable",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:unusable"
          ],
          "reason_code": "data_unusable_setting_value",
          "reason_texts": [
            "Data unusable: a setting, list or rule state this policy reads is malformed, unknown or ambiguous."
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ],
          "verdict": "not_assessed"
        },
        "unit_violates": {
          "reason_code": "unit_violates",
          "reason_texts": [
            "Requirement not met: at least one org unit or group holds a value this policy forbids."
          ],
          "verdict": "not_met"
        }
      }
    }
