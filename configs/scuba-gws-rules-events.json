{
  "kinds": {
    "setting_event": {
      "cells": {
        "section_not_collected": {
          "verdict": "not_assessed",
          "reason_code": "required_evidence_section_not_collected",
          "evidence_kind": null,
          "limitations": [
            "required_evidence_section_not_collected",
            "required_evidence_section_not_collected:<section>"
          ],
          "recommendations": [
            "collect_missing_evidence_section"
          ]
        },
        "section_shape_unusable": {
          "verdict": "not_assessed",
          "reason_code": "data_unusable_section_shape",
          "reason_texts": [
            "Data unusable: the tenant topology is cut, broken or of the wrong shape, or the setting-change events, their log window or the policy section has the wrong shape."
          ],
          "evidence_kind": "unusable",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:unusable"
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ]
        },
        "event_read_incomplete": {
          "verdict": "not_assessed",
          "reason_code": "data_unavailable_event_read_incomplete",
          "reason_texts": [
            "Data unavailable: the admin setting-change event read was cut or incomplete, so the last change per unit is not known."
          ],
          "evidence_kind": "absent",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:absent"
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ]
        },
        "policy_read_incomplete": {
          "verdict": "not_assessed",
          "reason_code": "data_unavailable_policy_read_incomplete",
          "reason_texts": [
            "Data unavailable: the policy read was cut or incomplete, so the service status is not known."
          ],
          "evidence_kind": "absent",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:absent"
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ]
        },
        "service_off_everywhere": {
          "verdict": "not_applicable",
          "reason_code": "service_off_everywhere",
          "reason_texts": [
            "Not applicable: the service is off in every unit."
          ]
        },
        "service_status_absent": {
          "verdict": "not_assessed",
          "reason_code": "data_unavailable_service_status_absent",
          "reason_texts": [
            "Data unavailable: the top-level unit has no readable service status and no unit has the service explicitly on."
          ],
          "evidence_kind": "absent",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:absent"
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ]
        },
        "unit_violates": {
          "verdict": "not_met",
          "reason_code": "unit_violates",
          "reason_texts": [
            "Requirement not met: the last logged setting change for at least one unit sets a non-compliant value."
          ]
        },
        "event_value_unusable": {
          "verdict": "not_assessed",
          "reason_code": "data_unusable_event_value",
          "reason_texts": [
            "Data unusable: a relevant setting-change event has a missing, unknown or unreadable value, time or unit, or two latest events disagree."
          ],
          "evidence_kind": "unusable",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:unusable"
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ]
        },
        "no_setting_event": {
          "verdict": "not_assessed",
          "reason_code": "data_unavailable_no_setting_event",
          "reason_texts": [
            "Data unavailable: the admin logs hold no current setting change at the top-level unit for every setting this policy reads; logs are kept about six months, and a reset to the default is not logged as a value."
          ],
          "evidence_kind": "absent",
          "limitations": [
            "evidence_unusable",
            "evidence_unusable:<section>:absent"
          ],
          "recommendations": [
            "recollect_unusable_evidence"
          ]
        },
        "no_unit_violates": {
          "verdict": "met",
          "reason_code": "no_unit_violates",
          "reason_texts": [
            "Requirement met: the top-level unit has a logged setting change for every setting this policy reads, and the last change for every unit is compliant."
          ]
        }
      }
    }
  },
